#: classes/wwpdf-settings.php:149
msgid "Enable Watermarking"
msgstr "Activez le tatouage"

#: classes/wwpdf-settings.php:150
msgid "Check to enable PDF watermarking"
msgstr "Cocher pour activer le filigranage PDF"

#: classes/wwpdf-settings.php:157
msgid "File(s) to watermark"
msgstr "Fichier (s) à filigrane"

#: classes/wwpdf-settings.php:158
msgid ""
"List file name(s) of PDF(s) to watermark, one per line, e.g., <code>upload."
"pdf</code> or <code>my_pdf.pdf</code> .<br />If left blank, WaterWoo PDF "
"will watermark all PDFs sold through WooCommerce."
msgstr ""
"Liste des noms des fichiers de PDF(s) de filigrane, un par ligne, par "
"exemple, <code>upload.pdf</code> ou <code>my_pdf.pdf</code> .<br>Si laissé "
"vide, WaterWoo PDF sera filigrane tous les PDFs vendus par l'intermédiaire "
"de WooCommerce."

#: classes/wwpdf-settings.php:166
msgid "Custom text for footer watermark"
msgstr "Texte personnalisé pour le filigrane de pied de page"

#: classes/wwpdf-settings.php:167
msgid ""
"Shortcodes available, all caps, in brackets: <code>[FIRSTNAME]</code> "
"<code>[LASTNAME]</code> <code>[EMAIL]</code> <code>[PHONE]</code> "
"<code>[DATE]</code>"
msgstr ""
"Shortcodes disponibles, tout en majuscules, entre parenthèses : "
"<code>[FIRSTNAME]</code> <code>[LASTNAME]</code> <code>[EMAIL]</code> "
"<code>[PHONE]</code><code>[DATE]</code>"

#: classes/wwpdf-settings.php:168
msgid "Licensed to [FIRSTNAME] [LASTNAME], [EMAIL]"
msgstr "Licence à [FIRSTNAME] [LASTNAME], [EMAIL]"

