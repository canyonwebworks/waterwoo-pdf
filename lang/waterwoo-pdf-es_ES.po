#: waterwoo-pdf.php:432
msgid "WaterWoo General Options"
msgstr "Opciones generales de WaterWoo"

#: waterwoo-pdf.php:439
msgid "Enable Watermarking"
msgstr "Activar marca de agua"

#: waterwoo-pdf.php:440
msgid "Check to enable PDF watermarking"
msgstr "Check para habilitar marcas de agua PDF"

#: waterwoo-pdf.php:447
msgid "File(s) to watermark"
msgstr "Archivo (s) a la marca de agua"

#: waterwoo-pdf.php:448
msgid ""
"List file name(s) of PDF(s) to watermark, one per line, e.g., <code>upload."
"pdf</code> or <code>my_pdf.pdf</code> .<br />If left blank, WaterWoo PDF "
"will watermark all PDFs sold through WooCommerce."
msgstr ""
"Lista de nombres de archivo de PDF(s) a la marca de agua, uno por línea, por "
"ejemplo, <code>upload.pdf</code> o <code>my_pdf.pdf</code> .<br>Si deja en "
"blanco, Waterloo PDF se marca de agua todos los PDFs de vendidos a través de "
"WooCommerce."

#: waterwoo-pdf.php:456
msgid "Custom text for footer watermark"
msgstr "Texto personalizado para la marca de agua de pie de página"

#: waterwoo-pdf.php:457
msgid ""
"Shortcodes available, all caps, in brackets: <code>[FIRSTNAME]</code> "
"<code>[LASTNAME]</code> <code>[EMAIL]</code> <code>[PHONE]</code> "
"<code>[DATE]</code>"
msgstr ""
"Shortcodes disponibles, mayúsculas, paréntesis: <code>[FIRSTNAME]</code> "
"<code>[LASTNAME]</code> <code>[EMAIL]</code> <code>[PHONE]</"
"code><code>[DATE]</code>"

